# Database configuration
DB_HOST=localhost
DB_USER=root
DB_NAME=feedback_db
DB_PASSWORD=yourpassword

# Email configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_email_password
ADMIN_EMAIL=admin_email@example.com,test@example.com

# Image Upload configuration
UPLOAD_DIR=FolderName/SubFolderName
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://your_r2_endpoint
CUSTOM_DOMAIN=https://your_custom_domain
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# Image Upload Settings
ALLOWED_IMAGE_TYPES=PNG,JPG,JPEG,HEIC,GIF
MAX_IMAGE_SIZE_MB=50

# Casdoor Configuration
CASDOOR_ENDPOINT=https://example.com
CASDOOR_CLIENT_ID=your_client_id
CASDOOR_CLIENT_SECRET=your_client_secret
CASDOOR_ORG_NAME=your_org_name
CASDOOR_APP_NAME=your_app_name

# JWT Configuration
# `JWT_ISSUER` should be the same as `CASDOOR_ENDPOINT`
# `JWT_AUDIENCE` should be the same as `CASDOOR_CLIENT_ID`
JWT_ISSUER=https://example.com
JWT_AUDIENCE=your_client_id

# Redis configuration (for token blacklist)
REDIS_URL=redis://localhost:6379

# Casdoor Certificate (replace with your actual certificate)
CASDOOR_CERTIFICATE="-----BEGIN CERTIFICATE-----
your_certificate_here
-----END CERTIFICATE-----"

# TBA Webhook Configuration
TBA_WEBHOOK_SECRET=your_webhook_secret
# Set to true to skip TBA HMAC verification (not recommended for production)
SKIP_TBA_HMAC_VERIFY=true

# Server configuration
PORT=3000