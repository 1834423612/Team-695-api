{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "./node_modules/@types",
    "src/**/*",
    "src/types/**/*",
    "./**/*",
    "./**/*.ts",
    "app.ts",
    "**/*.json"
  ],
  "exclude": ["node_modules"]
}
